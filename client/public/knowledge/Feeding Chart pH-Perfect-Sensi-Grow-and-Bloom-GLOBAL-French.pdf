            <rdf:Bag>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Repeat week 4 of either schedule if you want a longer vegetativ</photoshop:LayerName>
                  <photoshop:LayerText>Repeat week 4 of either schedule if you want a longer vegetative period, or are cultivating a strain that requires more time to bloom.</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>*All measurements are shown in Milliliters per Gallon. 1ML per </photoshop:LayerName>
                  <photoshop:LayerText>*All measurements are shown in Milliliters per Gallon. 1ML per Liter = 4ML per Gallon. 1 US Gallon = 3.78 Liters **For you convenience, per gallon amounts are measured to the nearest milliliter.</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>12hrs of light 12hrs of dark</photoshop:LayerName>
                  <photoshop:LayerText>12hrs of light 12hrs of dark</photoshop:LayerText>
